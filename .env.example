# Change only this selector when switching environments.
# Allowed values: development or production.
APP_ENV=development

# Local development profile.
DEVELOPMENT_HOST=127.0.0.1
DEVELOPMENT_PORT=4200
DEVELOPMENT_APP_ORIGIN=http://localhost:4200
DEVELOPMENT_APP_BASE_PATH=

# EC2 production profile.
PRODUCTION_HOST=127.0.0.1
PRODUCTION_PORT=43127
PRODUCTION_APP_ORIGIN=https://apps.unithera.com
PRODUCTION_APP_BASE_PATH=/dashboardapp

# The Cognito app client must allow both profiles:
# Development callback: http://localhost:4200/callback
# Development sign-out: http://localhost:4200
# Production callback: https://apps.unithera.com/dashboardapp/callback
# Production sign-out: https://apps.unithera.com/dashboardapp
SSO_ENABLED=true
COGNITO_BASE_URI=https://unithera.auth.us-east-1.amazoncognito.com
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_wA4ljIC93
COGNITO_CLIENT_ID=6j6b3e9k2pbtolusk7jfbq8d8s
COGNITO_CLIENT_SECRET=
COGNITO_SCOPES=openid,profile,email
# Optional comma-separated Cognito group allowlist. Leave blank to allow any
# authenticated user from this user pool.
COGNITO_ALLOWED_GROUPS=cf87404c-94bf-44ca-967f-ccc5b1aecdbc
# Cognito tokens stay in this single server process; browsers receive only a
# small opaque session cookie. A container restart requires users to sign in again.
COGNITO_SESSION_DAYS=30
COGNITO_MAX_SESSIONS=2000
COGNITO_REQUEST_TIMEOUT_MS=10000

# SSO user permissions and worklists. These dedicated connection values
# intentionally do not fall back to the claim-source database; enter the dev
# UniLocus database credentials.
USER_PERMISSIONS_SCHEMA=UniLocus
USER_PERMISSIONS_TABLE=claims_dashboard_user_permissions
WORKLIST_SCHEMA=UniLocus
WORKLIST_TYPES_TABLE=claims_dashboard_worklist_types
CLAIM_WORKLISTS_TABLE=claims_dashboard_claim_worklists
PERMISSIONS_DB_HOST=
PERMISSIONS_DB_PORT=3306
PERMISSIONS_DB_USER=
PERMISSIONS_DB_PASSWORD=
PERMISSIONS_DB_SSL=false
PERMISSIONS_DB_CONNECTION_LIMIT=2
PERMISSIONS_DB_QUERY_TIMEOUT_MS=10000

# MySQL credentials. Use a database account with SELECT-only grants.
# When MySQL runs on the Docker host, set DB_HOST=host.docker.internal.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=readonly_user
DB_PASSWORD=
DB_NAME=unidata
DB_SSL=false
DB_CONNECTION_LIMIT=5
DB_QUERY_TIMEOUT_MS=20000

# A claim is considered paid when cumulative reconciled payments reach this
# percentage of its latest charge. Values must be greater than 0 and at most 100.
CLAIM_PAID_THRESHOLD_PERCENT=50

# Optional categorized claim source. The key is used only by the Express server
# and is never included in browser JavaScript.
CLAIMS_API_BASE_URL=https://apps.unithera.com/rcm-clustering/presubmission/api/v1
CLAIMS_API_KEY=
CLAIMS_API_WORKFLOW=presubmission
CLAIMS_API_TIMEOUT_MS=30000

# Optional schema/table overrides.
UNIDATA_SCHEMA=unidata
UNICOIN_SCHEMA=uniCoin
RCM_SCHEMA=RCM
EHR_SCHEMA=EHR
EHR_LICENSE_KEY=161549
EHR_TRANSACTION_SOURCE=AMD
EHR_PATIENT_TABLE=vw_ODBC_pt_PatientInfo
TRANSACTIONS_TABLE=FlattenTransctions2
CLAIM_STATUS_TABLE=ClaimStatus
PATIENT_INVOICE_TABLE=patient_invoices
EDI_835_TABLE=edi_835

# Optional Salesforce claim-comment integration. Reads always use guarded SOQL
# SELECT queries. Note creation remains disabled unless the explicit write switch
# is enabled and the signed-in user belongs to a configured writer group.
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_REFRESH_TOKEN=
SF_API_VERSION=v61.0
SF_CASE_OBJECT=UniSuite_RCM_Case__c
SF_NOTE_OBJECT=UniSuite_RCM_Case_Note__c
SF_STATUS_FIELD=UniSuite_Status__c
SF_CLAIM_ID_FIELD=UniSuite_Claim_ID__c
SF_ICN_FIELD=UniSuite_ICN__c
SF_NOTE_CASE_FIELD=UniSuite_RCM_Case__c
SF_NOTE_ACTION_FIELD=UniSuite_Action__c
SF_NOTE_FOLLOWUP_FIELD=UniSuite_Follow_Up_Action__c
SF_NOTE_TEXT_FIELD=UniSuite_Text__c
SF_NOTE_PAID_FIELD=UniSuite_Paid__c
SF_NOTE_ALLOWED_FIELD=UniSuite_Allowed_Amount__c
SF_NOTE_AMOUNT_FIELD=UniSuite_Amount__c
SF_NOTE_CHECK_FIELD=UniSuite_Check_EFT_Number__c
SF_NOTE_CLEARED_FIELD=UniSuite_Cleared_Date__c
SF_NOTE_ISSUE_FIELD=UniSuite_Issue_Date__c
SF_NOTE_POSTING_ISSUE_FIELD=UniSuite_Payment_Posting_Issue__c
# Production-safe defaults: no Salesforce write is possible while this is false,
# and an empty writer-group list denies every user even when enabled.
SF_NOTE_WRITES_ENABLED=false
SF_NOTE_WRITER_GROUPS=
SF_NOTE_RECORD_TYPE=Claim
SF_NOTE_MAX_CHARS=5000
SF_TIMEOUT_MS=30000
SF_MAX_COMMENTS=100

# Optional Gemini categorization. Claim comments are sent to the configured
# Gemini account, so use only an account/project approved for this data.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_ATTEMPTS=3
GEMINI_CONCURRENCY=3
GEMINI_MAX_COMMENT_CHARS=5000

# Alternatively, use Vertex AI with service-account credentials instead of
# GEMINI_API_KEY. Keep the private key quoted with literal \n line breaks.
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_SERVICE_ACCOUNT_TYPE=service_account
GOOGLE_SERVICE_ACCOUNT_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_ID=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_CLIENT_ID=
GOOGLE_SERVICE_ACCOUNT_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_SERVICE_ACCOUNT_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_SERVICE_ACCOUNT_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_SERVICE_ACCOUNT_CLIENT_X509_CERT_URL=
GOOGLE_SERVICE_ACCOUNT_UNIVERSE_DOMAIN=googleapis.com
